<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.fludakit</groupId>
        <artifactId>fludakit-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>fluda-data-parent</artifactId>
    <packaging>pom</packaging>

    <name>FluDa :: Data</name>
    <description>A fluent data-access toolkit for Jakarta EE / CDI applications.</description>
    <url>https://github.com/fludakit/data</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Hantsy Bai</name>
            <email>hantsy@gmail.com</email>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/fludakit/data.git</connection>
        <developerConnection>scm:git:ssh://github.com/fludakit/data.git</developerConnection>
        <url>https://github.com/fludakit/data</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>core</module>
        <module>qbn</module>
        <module>processor</module>
        <module>integration-tests</module>
    </modules>

    <properties>
        <fluda-jdbc-client.version>1.0.0-SNAPSHOT</fluda-jdbc-client.version>
        <h2.version>2.5.252</h2.version>
        <antlr.version>4.13.2</antlr.version>
        <javapoet.version>1.13.0</javapoet.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-data-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-data-qbn</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-data-processor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-data-integration-tests</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-jdbc-client-core</artifactId>
                <version>${fluda-jdbc-client.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.fludakit</groupId>
                <artifactId>fluda-jdbc-client-cdi</artifactId>
                <version>${fluda-jdbc-client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup</groupId>
                <artifactId>javapoet</artifactId>
                <version>${javapoet.version}</version>
            </dependency>
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-runtime</artifactId>
                <version>${antlr.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.antlr</groupId>
                    <artifactId>antlr4-maven-plugin</artifactId>
                    <version>${antlr.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
          Module-specific profiles can be added here.

          The Jakarta Data TCK runner is not part of this reactor: it lives in tck-runner/, which is
          git-ignored and run standalone when someone wants to verify against the TCK. See
          tck-runner/README.md.
        -->
    </profiles>

    <distributionManagement>
        <repository>
            <id>github-fludakit</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/fludakit/data</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <name>GitHub Packages - Fludakit Org</name>
            <id>github-fludakit</id>
            <url>https://maven.pkg.github.com/fludakit/*</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
